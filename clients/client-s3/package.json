{
  "name": "ibm-cos-sdk-v2",
  "description": "IBM COS SDK for JavaScript S3 Client for Node.js, Browser and React Native",
  "version": "1.0.0",
  "scripts": {
    "build": "concurrently 'yarn:build:es' 'yarn:build:types' && yarn build:cjs",
    "build:cjs": "node ../../scripts/compilation/inline client-s3",
    "build:es": "tsc -p tsconfig.es.json",
    "build:include:deps": "yarn g:turbo run build -F=\"ibm-cos-sdk-v2\"",
    "build:types": "tsc -p tsconfig.types.json",
    "build:types:downlevel": "downlevel-dts dist-types dist-types/ts3.4",
    "clean": "premove dist-cjs dist-es dist-types tsconfig.cjs.tsbuildinfo tsconfig.es.tsbuildinfo tsconfig.types.tsbuildinfo",
    "extract:docs": "api-extractor run --local",
    "generate:client": "node ../../scripts/generate-clients/single-service --solo s3",
    "test:index": "tsc --noEmit ./test/index-types.ts && node ./test/index-objects.spec.mjs"
  },
  "main": "./dist-cjs/index.js",
  "types": "./dist-types/index.d.ts",
  "module": "./dist-es/index.js",
  "sideEffects": false,
  "dependencies": {
    "@aws-crypto/crc32": "^5.2.0",
    "@aws-crypto/crc32c": "^5.2.0",
    "@aws-crypto/sha1-browser": "^5.2.0",
    "@aws-crypto/sha256-browser": "^5.2.0",
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-crypto/util": "^5.2.0",
    "@aws/lambda-invoke-store": "^0.2.2",
    "@ibm-cos/core": "workspace:*",
    "@ibm-cos/crc64-nvme": "workspace:*",
    "@ibm-cos/credential-provider-env": "workspace:*",
    "@ibm-cos/credential-provider-env-ibm": "workspace:*",
    "@ibm-cos/credential-provider-http": "workspace:*",
    "@ibm-cos/credential-provider-iam": "workspace:*",
    "@ibm-cos/credential-provider-ini": "workspace:*",
    "@ibm-cos/credential-provider-ini-ibm": "workspace:*",
    "@ibm-cos/credential-provider-node": "workspace:*",
    "@ibm-cos/credential-provider-process": "workspace:*",
    "@ibm-cos/middleware-bucket-endpoint": "workspace:*",
    "@ibm-cos/middleware-expect-continue": "workspace:*",
    "@ibm-cos/middleware-flexible-checksums": "workspace:*",
    "@ibm-cos/middleware-host-header": "workspace:*",
    "@ibm-cos/middleware-location-constraint": "workspace:*",
    "@ibm-cos/middleware-logger": "workspace:*",
    "@ibm-cos/middleware-recursion-detection": "workspace:*",
    "@ibm-cos/middleware-sdk-s3": "workspace:*",
    "@ibm-cos/middleware-ssec": "workspace:*",
    "@ibm-cos/middleware-user-agent": "workspace:*",
    "@ibm-cos/region-config-resolver": "workspace:*",
    "@ibm-cos/signature-ibm-iam": "workspace:*",
    "@ibm-cos/types": "workspace:*",
    "@ibm-cos/types-ibm": "workspace:*",
    "@ibm-cos/util-arn-parser": "workspace:*",
    "@ibm-cos/util-endpoints": "workspace:*",
    "@ibm-cos/util-user-agent-browser": "workspace:*",
    "@ibm-cos/util-user-agent-node": "workspace:*",
    "@ibm-cos/xml-builder": "workspace:*",
    "@smithy/config-resolver": "^4.4.6",
    "@smithy/core": "^3.21.0",
    "@smithy/credential-provider-imds": "^4.2.8",
    "@smithy/eventstream-serde-browser": "^4.2.8",
    "@smithy/eventstream-serde-config-resolver": "^4.3.8",
    "@smithy/eventstream-serde-node": "^4.2.8",
    "@smithy/fetch-http-handler": "^5.3.9",
    "@smithy/hash-blob-browser": "^4.2.9",
    "@smithy/hash-node": "^4.2.8",
    "@smithy/hash-stream-node": "^4.2.8",
    "@smithy/invalid-dependency": "^4.2.8",
    "@smithy/is-array-buffer": "^4.2.0",
    "@smithy/md5-js": "^4.2.8",
    "@smithy/middleware-content-length": "^4.2.8",
    "@smithy/middleware-endpoint": "^4.4.10",
    "@smithy/middleware-retry": "^4.4.26",
    "@smithy/middleware-serde": "^4.2.9",
    "@smithy/middleware-stack": "^4.2.8",
    "@smithy/node-config-provider": "^4.3.8",
    "@smithy/node-http-handler": "^4.4.8",
    "@smithy/property-provider": "^4.2.8",
    "@smithy/protocol-http": "^5.3.8",
    "@smithy/shared-ini-file-loader": "^4.4.3",
    "@smithy/signature-v4": "^5.3.8",
    "@smithy/smithy-client": "^4.10.11",
    "@smithy/types": "^4.12.0",
    "@smithy/url-parser": "^4.2.8",
    "@smithy/util-base64": "^4.3.0",
    "@smithy/util-body-length-browser": "^4.2.0",
    "@smithy/util-body-length-node": "^4.2.1",
    "@smithy/util-config-provider": "^4.2.0",
    "@smithy/util-defaults-mode-browser": "^4.3.25",
    "@smithy/util-defaults-mode-node": "^4.2.28",
    "@smithy/util-endpoints": "^3.2.8",
    "@smithy/util-middleware": "^4.2.8",
    "@smithy/util-retry": "^4.2.8",
    "@smithy/util-stream": "^4.5.10",
    "@smithy/util-utf8": "^4.2.0",
    "@smithy/util-waiter": "^4.2.8",
    "bowser": "^2.11.0",
    "fast-xml-parser": "5.7.3",
    "ibm-cloud-sdk-core": "5.4.12",
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "@tsconfig/node20": "20.1.8",
    "@types/node": "^20.14.8",
    "concurrently": "7.0.0",
    "downlevel-dts": "0.10.1",
    "premove": "4.0.0",
    "typescript": "~5.8.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "typesVersions": {
    "<4.0": {
      "dist-types/*": [
        "dist-types/ts3.4/*"
      ]
    }
  },
  "files": [
    "dist-*/**"
  ],
  "author": {
    "name": "IBM COS SDK for JavaScript",
    "url": "https://github.com/IBM/ibm-cos-sdk-js-v2"
  },
  "license": "Apache-2.0",
  "browser": {
    "./dist-es/runtimeConfig": "./dist-es/runtimeConfig.browser"
  },
  "react-native": {
    "./dist-es/runtimeConfig": "./dist-es/runtimeConfig.native"
  },
  "homepage": "https://github.com/ibm/ibm-cos-sdk-js-v2",
  "repository": {
    "type": "git",
    "url": "https://github.com/ibm/ibm-cos-sdk-js-v2.git",
    "directory": "clients/client-s3"
  }
}
