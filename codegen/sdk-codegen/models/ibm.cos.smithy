///          </important>
@httpChecksum(
    requestAlgorithmMember: "ChecksumAlgorithm"
    requestChecksumRequired: true
)
@http(
    method: "POST"
    uri: "/{Bucket}?metadataConfiguration"
    code: 200
)
@staticContextParams(
    UseS3ExpressControlEndpoint: {
        value: true
    }
)
operation CreateBucketMetadataConfiguration {
    input: CreateBucketMetadataConfigurationRequest
