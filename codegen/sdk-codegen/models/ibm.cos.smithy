                                                {
                                                    fn: "booleanEquals"
                                                    argv: [
                                                        {
                                                            ref: "DisableS3ExpressSessionAuth"
                                                        }
                                                        true
                                                    ]
                                                }
                                            ]
                                            rules: [
                                                {
                                                    conditions: [
                                                        {
                                                            fn: "substring"
                                                            argv: [
                                                                {
                                                                    ref: "Bucket"
                                                                }
                                                                6
                                                                14
                                                                true
                                                            ]
                                                            assign: "s3expressAvailabilityZoneId"
                                                        }
                                                        {
                                                            fn: "substring"
                                                            argv: [
                                                                {
                                                                    ref: "Bucket"
                                                                }
                                                                14
                                                                16
                                                                true
                                                            ]
                                                            assign: "s3expressAvailabilityZoneDelim"
