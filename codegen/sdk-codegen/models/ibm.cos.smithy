                state: "retry"
                matcher: {
                    errorType: "NotFound"
                }
            }
        ]
        minDelay: 5
    }
    ObjectNotExists: {
        acceptors: [
            {
                state: "success"
                matcher: {
                    errorType: "NotFound"
                }
            }
