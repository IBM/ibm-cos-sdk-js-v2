                                                                    argv: [
                                                                        {
                                                                            ref: "UseFIPS"
                                                                        }
                                                                        false
                                                                    ]
                                                                }
                                                                {
                                                                    fn: "booleanEquals"
                                                                    argv: [
                                                                        {
                                                                            ref: "UseDualStack"
                                                                        }
                                                                        true
                                                                    ]
                                                                }
                                                            ]
                                                            endpoint: {
                                                                url: "https://{Bucket}.s3express-{s3expressAvailabilityZoneId}.dualstack.{Region}.{partitionResult#dnsSuffix}"
                                                                properties: {
                                                                    backend: "S3Express"
                                                                    authSchemes: [
