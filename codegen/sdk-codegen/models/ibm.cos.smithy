    Records: RecordsEvent
    /// <p>The Stats Event.</p>
    Stats: StatsEvent
    /// <p>The Progress Event.</p>
    Progress: ProgressEvent
    /// <p>The Continuation Event.</p>
    Cont: ContinuationEvent
    /// <p>The End Event.</p>
    End: EndEvent
}

