///          </important>
@examples([
    {
        title: "To get lifecycle configuration on a bucket"
        documentation: "The following example retrieves lifecycle configuration on set on a bucket. "
        input: {
            Bucket: "examplebucket"
        }
        output: {
            Rules: [
                {
                    Prefix: "TaxDocs"
                    Status: "Enabled"
                    Transitions: [
                        {
                            Days: 365
                            StorageClass: "STANDARD_IA"
                        }
                    ]
                    ID: "Rule for TaxDocs/"
                }
            ]
        }
    }
])
