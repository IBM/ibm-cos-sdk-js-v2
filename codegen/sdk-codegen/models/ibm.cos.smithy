///                   </li>
///                </ul>
///             </dd>
///             <dt>Encryption</dt>
///             <dd>
///                <ul>
///                   <li>
///                      <p>
///                         <b>General purpose buckets</b> - Server-side encryption is for
///                 data encryption at rest. Amazon S3 encrypts your data as it writes it to disks in its data centers
