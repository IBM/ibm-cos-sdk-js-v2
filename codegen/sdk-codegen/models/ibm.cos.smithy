            ///          <note>
            ///             <p>This functionality is not supported for directory buckets.</p>
            ///          </note>
            @httpHeader("x-amz-delete-marker")
            DeleteMarker: DeleteMarker
            /// <p>Date and time when the object was last modified.</p>
            @httpHeader("Last-Modified")
            LastModified: LastModified
            /// <p>The version ID of the object.</p>
            ///          <note>
            ///             <p>This functionality is not supported for directory buckets.</p>
            ///          </note>
            @httpHeader("x-amz-version-id")
            VersionId: ObjectVersionId
            @httpHeader("x-amz-request-charged")
            RequestCharged: RequestCharged
            /// <p>An ETag is an opaque identifier assigned by a web server to a specific version of a resource found
            ///       at a URL.</p>
            ETag: ETag
            /// <p>The checksum or digest of the object.</p>
            Checksum: Checksum
            /// <p>A collection of parts associated with a multipart upload.</p>
            ObjectParts: GetObjectAttributesParts
