                                                                                            argv: [
                                                                                                {
                                                                                                    ref: "bucketArn"
                                                                                                }
                                                                                                "partition"
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                            rules: [
                                                                                {
                                                                                    conditions: []
                                                                                    endpoint: {
                                                                                        url: "https://{accessPointName}.accesspoint.s3-global.{mrapPartition#dnsSuffix}"
                                                                                        properties: {
                                                                                            authSchemes: [
                                                                                                {
                                                                                                    disableDoubleEncoding: true
