    ///                </p>
    ///             </li>
    ///             <li>
    ///                <p>
    ///                   <code>CRC32C</code>
    ///                </p>
    ///             </li>
    ///             <li>
    ///                <p>
    ///                   <code>CRC64NVME</code>
    ///                </p>
    ///             </li>
    ///             <li>
    ///                <p>
    ///                   <code>SHA1</code>
    ///                </p>
    ///             </li>
    ///             <li>
