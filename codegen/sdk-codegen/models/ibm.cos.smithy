///                                  </li>
///                                  <li>
///                                     <p> US West (Oregon)</p>
///                                  </li>
///                                  <li>
///                                     <p> Asia Pacific (Singapore)</p>
///                                  </li>
///                                  <li>
///                                     <p>Asia Pacific (Sydney)</p>
///                                  </li>
///                                  <li>
///                                     <p>Asia Pacific (Tokyo)</p>
///                                  </li>
///                                  <li>
///                                     <p>Europe (Ireland)</p>
///                                  </li>
///                                  <li>
///                                     <p>South America (São Paulo)</p>
///                                  </li>
