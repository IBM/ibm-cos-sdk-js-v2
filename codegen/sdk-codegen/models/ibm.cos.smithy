        input: {
            Bucket: "sourcebucket"
            BucketLoggingStatus: {
                LoggingEnabled: {
                    TargetBucket: "targetbucket"
                    TargetPrefix: "MyBucketLogs/"
                    TargetGrants: [
                        {
                            Grantee: {
                                Type: "Group"
                                URI: "http://acs.amazonaws.com/groups/global/AllUsers"
                            }
                            Permission: "READ"
                        }
                    ]
                }
            }
        }
    }
])
