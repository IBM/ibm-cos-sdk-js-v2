///          </important>
@httpChecksum(
    requestAlgorithmMember: "ChecksumAlgorithm"
    requestChecksumRequired: true
)
@examples([
    {
        title: "To add tags to an existing object"
        documentation: "The following example adds tags to an existing object."
        input: {
            Bucket: "examplebucket"
            Key: "HappyFace.jpg"
            Tagging: {
                TagSet: [
                    {
                        Key: "Key3"
                        Value: "Value3"
                    }
                    {
                        Key: "Key4"
                        Value: "Value4"
                    }
                ]
            }
        }
