{
  "name": "ibm-cos-sdk-js-v2",
  "private": true,
  "version": "1.0.0",
  "description": "IBM COS SDK for JavaScript",
  "main": "index.js",
  "scripts": {
    "bootstrap": "yarn",
    "bootstrap:ci": "yarn install --frozen-lockfile",
    "benchmark:bundlers": "node ./tests/bundlers/runner/run.mjs",
    "build:all": "node ./scripts/turbo build",
    "build:ci": "node ./scripts/turbo build",
    "build:clients:since:release": "node ./scripts/turbo build -F=./packages/* -F=./clients/* -F=./lib/*",
    "build:crypto-dependencies": "node ./scripts/turbo build -F=@ibm-cos/types",
    "build:packages": "node ./scripts/turbo build -F=./packages/*",
    "build:types:downlevel": "node ./scripts/downlevel-dts/index.mjs",
    "clean": "yarn clear-build-cache && yarn clear-build-info",
    "clear-build-docs": "rimraf ./clients/*/docs/ ./dist/docs/clients/*/docs/ ./clientDocs",
    "clear-build-cache": "rimraf ./packages/*/dist-* ./clients/*/dist-* ./lib/*/dist-* ./private/*/dist-*",
    "clear-build-info": "rimraf ./packages/**/*.tsbuildinfo ./clients/**/*.tsbuildinfo  ./lib/**/*.tsbuildinfo ./private/**/*.tsbuildinfo",
    "g:turbo": "cd $INIT_CWD && turbo",
    "g:vitest": "cd $INIT_CWD && vitest",
    "g:jest": "cd $INIT_CWD && jest",
    "generate-clients": "node ./scripts/generate-clients",
    "lint:versions": "node scripts/runtime-dependency-version-check/runtime-dep-version-check.js",
    "lint:dependencies": "node scripts/runtime-dependency-version-check/check-dependencies.js",
    "lint:api": "node scripts/validation/api-snapshot-validation.js",
    "publish:local": "node ./scripts/publish.js",
    "verdaccio:start": "node ./scripts/verdaccio-publish/index.js",
    "verdaccio:cleanup": "rm -rf verdaccio/storage",
    "pack:all": "node ./scripts/generate-tarballs.js",
    "validate:publish": "node ./scripts/pre-publish-check.js",
    "test:size": "node ./tests/bundlers/runner/run.mjs",
    "test:unit": "make test-unit",
    "version:all": "lerna version --no-private --no-push --no-git-tag-version",
    "version:patch": "lerna version patch --no-private --no-push --no-git-tag-version --yes",
    "version:minor": "lerna version minor --no-private --no-push --no-git-tag-version --yes",
    "version:major": "lerna version major --no-private --no-push --no-git-tag-version --yes",
    "version:prerelease": "lerna version prerelease --preid beta --no-private --no-push --no-git-tag-version --yes",
    "version:list": "lerna list --all --long",
    "version:changed": "lerna changed",
    "version:diff": "lerna diff",
    "deps:sync": "node scripts/sync-dependencies.js sync",
    "deps:sync:dry": "node scripts/sync-dependencies.js sync --dry-run",
    "deps:sync:verbose": "node scripts/sync-dependencies.js sync --verbose",
    "deps:validate": "node scripts/sync-dependencies.js validate",
    "deps:list": "node scripts/sync-dependencies.js list",
    "deps:update": "yarn deps:sync && yarn install",
    "build:html": "typedoc"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:ibm/ibm-cos-sdk-js-v2.git"
  },
  "author": {
    "name": "IBM COS SDK for JavaScript",
    "url": "https://github.com/IBM/ibm-cos-sdk-js-v2"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.2",
    "@rollup/plugin-typescript": "^12.1.4",
    "fs-extra": "^9.0.0",
    "glob": "7.1.6",
    "lerna": "^8.1.8",
    "prettier": "2.8.5",
    "rimraf": "5.0.10",
    "rollup": "4.0.0",
    "turbo": "2.5.8",
    "yargs": "17.5.1"
  },
  "overrides": {
    "typescript": "~5.8.3"
  },
  "resolutions": {
    "typescript": "~5.8.3"
  },
  "workspaces": {
    "packages": [
      "clients/*",
      "lib/*",
      "packages/*",
      "packages-internal/*"
    ]
  },
  "packageManager": "yarn@4.10.3"
}
