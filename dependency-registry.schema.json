{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Dependency Registry Schema",
  "description": "Schema for the central dependency registry file",
  "type": "object",
  "required": ["dependencies", "devDependencies"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference"
    },
    "description": {
      "type": "string",
      "description": "Description of this registry file"
    },
    "dependencies": {
      "type": "object",
      "description": "Runtime dependencies used across workspace packages",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[~^]?[0-9]+\\.[0-9]+\\.[0-9]+"
      }
    },
    "devDependencies": {
      "type": "object",
      "description": "Development dependencies used across workspace packages",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[~^]?[0-9]+\\.[0-9]+\\.[0-9]+"
      }
    },
    "workspaceSpecificDevDependencies": {
      "type": "object",
      "description": "Configuration for workspace-specific dependencies",
      "properties": {
        "description": {
          "type": "string"
        },
        "allowed": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of dependencies that are allowed to be workspace-specific"
        }
      }
    }
  }
}